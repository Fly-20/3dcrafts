# Create a Resend API key and set the verified sender address before deploying.
RESEND_API_KEY=re_your_key_here
QUOTE_FROM_EMAIL="3DCRAFTS Quotes <quotes@your-domain.co.uk>"
QUOTE_TO_EMAIL=hello@3dcrafts.uk
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/your-webhook-id/your-webhook-token
GOOGLE_SITE_VERIFICATION=
GOOGLE_BUSINESS_PROFILE_URL=

# Public site URL, used to build Stripe success/cancel redirect URLs and admin order links.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase (see supabase/migrations/0001_phase1_schema.sql for the schema to run first).
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key_here
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# Stripe (test-mode keys to start — see Section 9 of the technical plan for the live-mode checklist).
STRIPE_SECRET_KEY=sk_test_your_key_here
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your_key_here
# Only available once the webhook route is registered in the Stripe dashboard (or `stripe listen` locally).
STRIPE_WEBHOOK_SECRET=whsec_your_signing_secret_here

# Order notifications (Section 6a) — reuses the existing Resend/Discord pattern from the quote form.
ORDERS_FROM_EMAIL="3DCRAFTS Orders <orders@your-domain.co.uk>"
STAFF_NOTIFICATION_EMAIL=hello@3dcrafts.uk
ORDERS_DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/your-webhook-id/your-webhook-token

# Rate limiting (Section 6g) — free tier at upstash.com (Redis > REST API tab has both values).
# Without these, /api/cart and /api/checkout fall back to unlimited (a console warning is logged).
UPSTASH_REDIS_REST_URL=https://your-db.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_rest_token_here

# Failed-payment staff alerts (Section 6a) — Discord notification only fires for abandoned
# checkouts at or above this amount, in pence, to avoid noise from ordinary cart abandonment.
# Optional — defaults to 15000 (£150) if unset.
HIGH_VALUE_ABANDONED_CART_PENCE=15000
